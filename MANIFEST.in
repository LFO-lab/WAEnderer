include README.md RELEASE_CHECKLIST.md ROADMAP_DUAL_INFERENCE.md
include requirements*.txt requirements*.lock uv.lock
include test_web*.js
recursive-include bin *.py
recursive-include web *.txt *.html *.js *.css *.json *.svg *.png *.woff *.woff2
recursive-include eval_scripts *.py
recursive-include tests *.py
recursive-include docs *.md *.json
prune corpus
prune eval_out
prune .venv
prune .venv-native
global-exclude __pycache__ *.py[cod]
